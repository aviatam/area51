[1.528, "o", "  \u001b[32m✔ published @area51-demo/json-fast-format@1.4.2 (zero-day: no advisory exists) and @area51-demo/clean-logger@2.0.0\u001b[0m\r\n"]
[0.096, "o", "  verdictseed: npm/@area51-demo/json-fast-format@1.4.2  critical (score 100, 3 finding(s))\r\n"]
[0.000, "o", "  verdictseed: npm/@area51-demo/clean-logger@2.0.0  none (score 0, 0 finding(s))\r\n"]
[0.006, "o", "\u001b[2m  Intent verdicts published for the exact tarball bytes (sha256 8087909c2514…, ea5e6b3bd981…).\u001b[0m\r\n"]
[0.000, "o", "\u001b[2m  On a KVM host intent-worker produces these by detonation; this Mac has no KVM, so they are seeded.\u001b[0m\r\n"]
[0.901, "o", "  \u001b[32m✔ agent group 'support-refund-agent' created (CLAUDE.md, policy, scenario, customers.csv, lockfile)\u001b[0m\r\n"]
[0.000, "o", "\r\n\u001b[1m\u001b[36m━━━ Scene 1 — Area51 alone (open source): containment, no behavioral verdicts ━━━\u001b[0m\r\n"]
