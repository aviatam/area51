{
  "name": "area51",
  "version": "2.2.1",
  "description": "AI agent containment runtime: scan, isolate, run, and quarantine autonomous agents.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "main": "dist/index.js",
  "bin": {
    "area51": "bin/area51"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky",
    "setup": "tsx setup/index.ts",
    "setup:auto": "tsx setup/auto.ts",
    "area51": "tsx src/cli/client.ts",
    "chat": "tsx scripts/chat.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:incus:e2e": "tsx scripts/incus-live-e2e.ts",
    "test:incus:vm:e2e": "tsx scripts/incus-vm-containment-e2e.ts",
    "test:portable:windows": "vitest run src/area51-demo.test.ts src/area51-exposure.test.ts src/agent-gate.test.ts src/runtime-policy.test.ts src/incus-adapter.test.ts src/incus-vm-network.test.ts src/incus-vm-disk.test.ts src/incus-vm-image.test.ts src/attachment-naming.test.ts src/container-config.test.ts src/container-runner.test.ts src/container-runtime.test.ts src/db/container-configs.test.ts src/modules/scheduling/db.test.ts src/modules/scheduling/recurrence.test.ts setup/channels/run-channel-skill.test.ts scripts/skill-directives.test.ts",
    "audit:high": "corepack pnpm audit --audit-level high",
    "verify": "corepack pnpm run audit:high && corepack pnpm run typecheck && corepack pnpm run test:portable:windows",
    "test:watch": "vitest"
  },
  "homepage": "https://docs.area51.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/aviatam/area51.git"
  },
  "bugs": {
    "url": "https://github.com/aviatam/area51/issues"
  },
  "keywords": [
    "ai-agent",
    "agent-runtime",
    "containment",
    "quarantine",
    "security",
    "incus",
    "automation"
  ],
  "dependencies": {
    "@clack/core": "^1.2.0",
    "@clack/prompts": "^1.2.0",
    "@onecli-sh/sdk": "2.2.1",
    "better-sqlite3": "11.10.0",
    "chat": "4.29.0",
    "cron-parser": "5.5.0",
    "kleur": "^4.1.5",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.18": "1.1.18",
      "vite@>=8.0.0 <=8.0.15": "8.0.16"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "eslint-plugin-no-catch-all": "^1.1.0",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
